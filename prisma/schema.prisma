generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PersonalInfo {
  id           Int      @id @default(1)
  name         String
  title        String
  tagline      String
  description  String
  email        String
  updatedAt    DateTime @updatedAt
  githubUrl    String?
  linkedinUrl  String?
  instagramUrl String?
}

model Skill {
  id    String @id @default(cuid())
  name  String
  icon  String
  order Int    @default(0)
}

model Project {
  id             String   @id @default(cuid())
  title          String
  description    String
  tags           String[]
  image          String
  demoUrl        String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  gallery        String[] @default([])
  githubLinks    Json     @default("[]")
  attachments    Json     @default("[]") // [{ name: string, url: string }]
}
